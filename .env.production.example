# Sunucuda:  cp .env.production.example .env  ve degerleri doldur.
# Kullanim:  docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# DATABASE_URL burada YOK: compose onu db servisine gore uretiyor
# (postgresql://<user>:<pass>@db:5432/<db>).

# --- Port bind adresi ---
# Prod'da 127.0.0.1: container portlari yalnizca sunucu icinden erisilir,
# disariya Plesk nginx aciyor. 0.0.0.0 birakilirsa 8000/8080/5434 internete acilir.
BIND_HOST=127.0.0.1

# --- Postgres (compose degisken ikamesi + db servisi icin) ---
POSTGRES_USER=macs_user
POSTGRES_PASSWORD=DEGISTIR-guclu-bir-sifre
POSTGRES_DB=macs_db
POSTGRES_PORT=5434
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- Frontend (compose build args) ---
# CRA bu degeri BUILD sirasinda bundle'a gomer, runtime'da degistirilemez.
# Degistirdikten sonra "up -d" YETMEZ, "--build frontend" sart.
# Sonunda / OLMAYACAK ve /api gibi bir sonek EKLENMEYECEK:
# frontend istekleri kendisi ekliyor (ornegin <bu deger>/events).
REACT_APP_API_URL=https://api.macsclub.com.tr
REACT_APP_MAPBOX_TOKEN=

# --- CORS ---
# main.py'deki varsayilan liste zaten macsclub.com.tr ve www'yi iceriyor.
# Ek origin gerekirse virgulle ayirip yaz.
CORS_ORIGINS=

# --- JWT ---
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=DEGISTIR-uzun-rastgele-deger
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Admin ---
ADMIN_SECRET_KEY=DEGISTIR-uzun-rastgele-deger

# --- Security ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15
MIN_PASSWORD_LENGTH=8

# --- Uploads ---
MAX_UPLOAD_SIZE=5242880

# Yuklenen gorsellerin HOST'taki klasoru; container'a bind mount edilir ve
# Plesk nginx'in "location /uploads/" alias'i AYNI yolu gostermeli.
# Yol yoksa compose hata verir (create_host_path: false) - once mkdir + chown:
#   sudo mkdir -p /var/www/vhosts/api.macsclub.com.tr/httpdocs/static/uploads
#   sudo chown -R 10001:10001 /var/www/vhosts/api.macsclub.com.tr/httpdocs/static/uploads
UPLOAD_HOST_DIR=/var/www/vhosts/api.macsclub.com.tr/httpdocs/static/uploads

# --- Diger ---
MAPBOX_TOKEN=
LOG_LEVEL=INFO

# 0 yapilirsa container acilisinda "alembic upgrade head" calismaz.
RUN_MIGRATIONS=1
