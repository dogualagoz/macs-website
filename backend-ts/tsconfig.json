{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "bench/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "contract/**/*.ts",
    "drizzle.config.ts"
  ]
}
