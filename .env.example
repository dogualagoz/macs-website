# cp .env.example .env  ve degerleri doldur.
# docker compose bu dosyayi hem degisken ikamesi hem de backend env_file icin kullanir.
# DATABASE_URL burada YOK: compose onu db servisine gore uretiyor.

# --- Postgres (compose degisken ikamesi icin) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=macs_db
POSTGRES_PORT=5434
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- Frontend (compose build args) ---
# CRA bu degerleri BUILD sirasinda bundle'a gomer. Degistirdikten sonra
# "docker compose up -d --build frontend" gerekir; salt "up -d" eski image'i kullanir.
# Prod: https://api.macsclub.com.tr  (sonunda / OLMAYACAK)
REACT_APP_API_URL=http://localhost:8000
REACT_APP_MAPBOX_TOKEN=

# --- CORS ---
# Frontend backend'den farkli origin'de. Varsayilan liste main.py'de
# (localhost:3000/5173/8080 + macsclub.com.tr + www). Ek origin gerekirse
# virgulle ayirip buraya yaz.
CORS_ORIGINS=

# --- JWT ---
JWT_SECRET_KEY=degistir-bunu-uzun-rastgele-bir-deger
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Admin ---
ADMIN_SECRET_KEY=degistir-bunu-da

# --- Security ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15
MIN_PASSWORD_LENGTH=8

# --- Uploads ---
MAX_UPLOAD_SIZE=5242880

# Yuklenen gorsellerin HOST'taki klasoru (container'a bind mount edilir).
# Lokal varsayilan: ./backend/static/uploads
# Prod: dosyalarin zaten durdugu vhost klasorunu goster, kopyalama yapma:
#   UPLOAD_HOST_DIR=/var/www/vhosts/api.macsclub.com.tr/httpdocs/static/uploads
# Klasor uid 10001 tarafindan yazilabilir olmali: chown -R 10001:10001 <klasor>
UPLOAD_HOST_DIR=./backend/static/uploads

# --- Diger ---
MAPBOX_TOKEN=
LOG_LEVEL=INFO

# 0 yapilirsa container acilisinda "alembic upgrade head" calismaz.
RUN_MIGRATIONS=1
